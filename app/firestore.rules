// Built by app-devkit tools/build-rules.mjs from firestore.app.rules and rules/common.rules. Edit those, then rebuild.
rules_version = '2';
// The app's rules. Edit this file, then build: node .devkit/tools/build-rules.mjs app/firestore.app.rules
// (writes firestore.rules, which is what deploys and the emulator use; CI fails when it is stale).
// Roles come from custom claims (app-devkit rules kit): { g: { _: role }, x, v, m }; '_' is the single group.
service cloud.firestore {
  match /databases/{database}/documents {
    // app-devkit rules/common.rules 1.5.0. Shared helpers, pasted in by tools/build-rules.mjs; do not edit the copy.
    // Claims (a cache of the app's role docs, never the source of truth; all optional):
    //   g  { <groupId>: <role> }  the user's role per group; a single-group app uses the key '_'
    //   x  unix seconds           access ends then (absent = no end)
    //   v  int                    claims version, bumped when the role docs change
    //   m  string                 sign-in method; written for the record, never read by rules
    // No email in authorisation. Lookups: only notRevoked() reads a document (1); the rest reads the token.

    function isSignedIn() { return request.auth != null; }

    // The user's role in group gid, or '' (no claim, other group, signed out).
    function role(gid) { return isSignedIn() ? request.auth.token.get('g', {}).get(gid, '') : ''; }

    function inGroup(gid) { return role(gid) != ''; }

    function hasRole(gid, roles) { return inGroup(gid) && role(gid) in roles; }

    // Not past the claim's access end. A malformed x fails closed.
    function live() {
      return isSignedIn() && (!('x' in request.auth.token) || request.time < timestamp.value(request.auth.token.x * 1000));
    }

    // One lookup: revoked/{uid} is written by the app's server when a member is removed, deleted when claims are re-issued.
    // Keep revoked/ closed to clients (no match block for it).
    function notRevoked() { return isSignedIn() && !exists(/databases/$(database)/documents/revoked/$(request.auth.uid)); }

    // The usual gate: role in the list, access not ended, not revoked (the lookup runs only when the role fits).
    function can(gid, roles) { return hasRole(gid, roles) && live() && notRevoked(); }

    // Migration form while old clients have no claims: the claim when present, else the role from the app's own doc.
    // Arguments are evaluated first, so a get() passed as docRole is read even when the claim decides. To skip that read,
    // write the same form inline: role(gid) != '' ? role(gid) : get(...).data.role (see the multi-group example).
    function roleOrDoc(gid, docRole) { return role(gid) != '' ? role(gid) : docRole; }

    // Server stamps (writes): stamped() requires serverAt == request.time; stampOk() also accepts no serverAt (old clients).
    function stamped() { return request.resource.data.get('serverAt', null) == request.time; }
    function stampOk() { return !('serverAt' in request.resource.data) || request.resource.data.serverAt == request.time; }

    // Partial updates from older clients that send no serverAt: it must stay exactly what the stored document has (absent
    // stays absent). Use instead of stampOk() on update only while such clients exist. Trade-off: the edit keeps its old
    // serverAt, so readers that fetch only what changed after a serverAt (server mode, incremental) do not see that edit
    // until their next full read (a weekly one, for apps that run one). Drop it once every client stamps.
    function stampKept() { return request.resource.data.get('serverAt', null) == resource.data.get('serverAt', null); }

    // The field is a timestamp that is not after the server's time (a future-dated version would sort first for good).
    // A client clock ahead of the server is refused too; write request.time with serverTimestamp where that matters.
    function notFuture(field) {
      return request.resource.data.get(field, null) is timestamp && request.resource.data.get(field, null) <= request.time;
    }

    // The field holds the signed-in user's uid (an author stamp nobody can write for someone else).
    function authorIs(field) { return isSignedIn() && request.resource.data.get(field, null) == request.auth.uid; }

    // The role docs: each person reads their own (the page watches its v); only admins write.
    match /members/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || can('_', ['admin']);
      allow create, update: if can('_', ['admin'])
        && request.resource.data.keys().hasOnly(['role', 'v', 'name'])
        && request.resource.data.role in ['admin', 'member', 'viewer']
        && request.resource.data.v is int;
      allow delete: if can('_', ['admin']);
    }

    // Where notes live: spaces/<uid> is the person's own vault (no space doc); spaces/s-<random> is a shared space
    // (S3), whose doc lists its members. Space ids must look like s-<8 to 40 letters or digits>, so nobody can make a
    // space doc named after someone's uid and so reach their vault. The app's own role (claims) still gates everything.
    function inVault(s) { return isSignedIn() && request.auth.uid == s; }
    function isSpace(s) { return s.matches('^s-[A-Za-z0-9]{8,40}$'); }
    function spaceRole(s) { return get(/databases/$(database)/documents/spaces/$(s)).data.members.get(request.auth.uid, ''); }
    function inSpace(s, roles) {
      return isSpace(s) && exists(/databases/$(database)/documents/spaces/$(s)) && spaceRole(s) in roles;
    }
    function mayRead(s) { return can('_', ['admin', 'member', 'viewer']) && (inVault(s) || inSpace(s, ['owner', 'edit', 'view'])); }
    // a space being deleted (closing, worker/spaces.js) takes no new writes
    function notClosing(s) { return get(/databases/$(database)/documents/spaces/$(s)).data.get('closing', false) == false; }
    function mayWrite(s) { return can('_', ['admin', 'member']) && (inVault(s) || (inSpace(s, ['owner', 'edit']) && notClosing(s))); }
    function optString(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }

    // A shared space: { name, owner, members: { uid: owner | edit | view }, memberIds, emails, invited, updatedAt,
    // closing? }. Members read it; only the Worker writes it (worker/spaces.js: make, rename, invite, roles, leave,
    // delete), so a device can never undo a member the Worker just added (decision 0010).
    match /spaces/{s} {
      allow get: if isSpace(s) && can('_', ['admin', 'member', 'viewer'])
        && (resource == null || request.auth.uid in resource.data.memberIds);
      // "my spaces": a query on memberIds array-contains the person (a list's rules can't read the doc id)
      allow list: if can('_', ['admin', 'member', 'viewer']) && request.auth.uid in resource.data.memberIds;
      allow create, update, delete: if false;
    }

    // Pending invites by email (worker/spaces.js): the Worker's alone.
    match /invites/{key} {
      allow read, write: if false;
    }

    // A note (src/notes/model.js): links, tags and aliases are worked out by the app; the body is at most 1 MiB (the
    // document limit; the app refuses a little earlier).
    match /spaces/{s}/notes/{id} {
      allow read: if mayRead(s);
      allow create, update: if mayWrite(s) && stamped()
        && request.resource.data.keys().hasOnly(['path', 'title', 'body', 'links', 'tags', 'aliases', 'daily', 'updatedAt', 'serverAt', '_edits'])
        && (!('_edits' in request.resource.data) || request.resource.data._edits is map)
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.body is string && request.resource.data.body.size() <= 1048576
        && optString(request.resource.data, 'path', 500)
        && optList(request.resource.data, 'links', 2000) && optList(request.resource.data, 'tags', 500)
        && optList(request.resource.data, 'aliases', 100)
        && (!('daily' in request.resource.data) || (request.resource.data.daily is string && request.resource.data.daily.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.updatedAt is number;
      allow delete: if mayWrite(s);
    }

    // A photo or file (@core/files, S4 attaches them to notes): the record only; the bytes are in the Worker's R2 bucket.
    match /spaces/{s}/files/{id} {
      allow read: if mayRead(s);
      allow create, update: if mayWrite(s) && stamped()
        && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'w', 'h', 'thumb', 'taken', 'state', 'item',
          'updatedAt', 'serverAt', '_edits'])
        && (!('_edits' in request.resource.data) || request.resource.data._edits is map)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 255
        && request.resource.data.type is string && request.resource.data.type.size() <= 129
        && request.resource.data.size is int && request.resource.data.size >= 0
        && request.resource.data.size <= 100000000
        && (!('w' in request.resource.data) || request.resource.data.w is int)
        && (!('h' in request.resource.data) || request.resource.data.h is int)
        && (!('thumb' in request.resource.data) || request.resource.data.thumb is bool)
        && (!('taken' in request.resource.data) || request.resource.data.taken is number)
        && request.resource.data.state in ['local', 'stored']
        && (!('item' in request.resource.data) || (request.resource.data.item is string && request.resource.data.item.size() > 0))
        && request.resource.data.updatedAt is number;
      allow delete: if mayWrite(s);
    }

    // Each person's account options (@core/settings): one doc named by their uid, in their own vault only.
    // One field per option (src/options.js); null forgets a saved value.
    match /spaces/{s}/settings/{id} {
      allow read: if can('_', ['admin', 'member', 'viewer']) && inVault(s);
      allow create, update: if can('_', ['admin', 'member', 'viewer']) && inVault(s) && request.auth.uid == id && stamped()
        && request.resource.data.keys().hasOnly(['profile', 'itemCount', 'updatedAt', 'serverAt', '_edits'])
        && (!('_edits' in request.resource.data) || request.resource.data._edits is map)
        && (!('profile' in request.resource.data) || request.resource.data.profile == null || request.resource.data.profile is string)
        && (!('itemCount' in request.resource.data) || request.resource.data.itemCount == null || request.resource.data.itemCount is bool)
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    // A deleted note's last version, written in the delete's own transaction (cloud.js onCommit).
    match /spaces/{s}/bin/{id} {
      allow read: if mayRead(s);
      allow create, update: if mayWrite(s) && stamped()
        && request.resource.data.keys().hasOnly(['id', 'kind', 'data', 'deletedAt', 'updatedAt', 'serverAt']);
    }
  }
}
