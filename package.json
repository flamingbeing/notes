{
  "name": "notes",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'worker/test/*.test.mjs' 'app/test/*.unit.test.mjs' 'tools/test/*.test.mjs'",
    "rules": "cd app && npx -y firebase-tools@15.33.0 emulators:exec --only firestore --project demo-notes \"node --test test/rules.test.mjs\"",
    "e2e": "playwright test",
    "typecheck": "tsc -p .",
    "vite": "node tools/vite-check.mjs && node tools/vite-outside-package.mjs && node tools/vite-pieces.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@playwright/test": "1.56.1",
    "app-sync": "github:flamingbeing/app-sync#v1.4.0",
    "app-ui": "github:flamingbeing/app-ui#v1.0.0-rc.10",
    "axe-core": "4.14.0",
    "dompurify": "3.4.17",
    "fflate": "0.8.2",
    "marked": "18.1.1",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
